 #if CUDART_VERSION >= 11030
 
+// Resolve via driver v2 because this vGPU runtime drops query status.
+// Exact NCCL API versions and driver failures remain enforced.
+static cudaError_t ncclDriverQuery(const char* name, void** ptr, int version,
+                                  cudaDriverEntryPointQueryResult* status) {
+  using Query = CUresult (*)(const char*, void**, int, cuuint64_t, CUdriverProcAddressQueryResult*);
+  static void* driver = dlopen("libcuda.so.1", RTLD_NOW | RTLD_LOCAL);
+  static Query query = driver ? (Query)dlsym(driver, "cuGetProcAddress_v2") : nullptr;
+  *ptr = nullptr;
+  *status = cudaDriverEntryPointSymbolNotFound;
+  if (!query) return cudaErrorUnknown;
+  CUdriverProcAddressQueryResult result = CU_GET_PROC_ADDRESS_SYMBOL_NOT_FOUND;
+  CUresult rc = query(name, ptr, version, CU_GET_PROC_ADDRESS_DEFAULT, &result);
+  if (rc != CUDA_SUCCESS) return cudaErrorUnknown;
+  if (result == CU_GET_PROC_ADDRESS_SUCCESS && *ptr) {
+    *status = cudaDriverEntryPointSuccess;
+    return cudaSuccess;
+  }
+  return cudaErrorUnknown;
+}
